# =====================================================================
# MindBridge AI - Environment Configuration Template
# NOTE: Replace placeholder values. Do not commit actual secrets to VCS.
# =====================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME=MindBridge AI
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Streamlit Frontend URL (for CORS validation)
FRONTEND_URL=http://localhost:8501
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Primary Database (MySQL 8.0)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/mindbridge
# Fallback database URL for offline testing / development when MySQL service is unreachable:
# Set to true to allow fallback to sqlite if MySQL connection fails in development mode
ALLOW_SQLITE_DEV_FALLBACK=true
DEV_SQLITE_URL=sqlite:///./mindbridge_dev.db

# Model Providers ("gemini", "openai", or "mock" for offline testing)
# You can set different providers per capability
LLM_PROVIDER=mock
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your_llm_api_key_here

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_API_KEY=your_embedding_api_key_here

VISION_PROVIDER=mock
VISION_MODEL=gemini-1.5-flash
VISION_API_KEY=your_vision_api_key_here

STT_PROVIDER=mock
STT_MODEL=whisper-1
STT_API_KEY=your_stt_api_key_here

TTS_PROVIDER=mock
TTS_MODEL=tts-1
TTS_API_KEY=your_tts_api_key_here

# RAG & Chunking Settings
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=4
RAG_RELEVANCE_THRESHOLD=0.35

# Upload & Resource Limits
MAX_DOCUMENT_SIZE_MB=10
MAX_IMAGE_SIZE_MB=5
MAX_AUDIO_SIZE_MB=10
MAX_PDF_PAGES=50
CONVERSATION_HISTORY_LIMIT=15

# Safety & Crisis Intervention
CRISIS_HELPLINE_US=988 (Suicide & Crisis Lifeline - call or text 24/7)
CRISIS_TEXT_LINE=Text HOME to 741741
CRISIS_INTERNATIONAL_URL=https://findahelpline.com/
